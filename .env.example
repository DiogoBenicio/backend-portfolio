# =============================================
# Portfolio — Variáveis de Ambiente
# Copie para .env e preencha os valores
# =============================================

# OpenWeather API (free tier suficiente)
# Obtenha em: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# PostgreSQL
POSTGRES_PASSWORD=your_postgres_password_here

# JWT — API Gateway
# Gere um secret forte: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_chars_here

# Admin credentials — acesso às rotas protegidas do gateway
ADMIN_USER=admin
ADMIN_PASS=your_admin_password_here

# ─── Ambiente ────────────────────────────────────────────────
# dev  → nginx.dev.conf  (HTTP, localhost)
# prod → nginx.prod.conf (HTTPS, Let's Encrypt)
NGINX_CONF=nginx.dev.conf

# ─── Apenas prod ─────────────────────────────────────────────
DOMAIN=your_domain_here
CERTBOT_EMAIL=your_email@example.com
